+#ifndef __ULTRAMODERN_SAVESTATE_HPP__
+#define __ULTRAMODERN_SAVESTATE_HPP__
+
+// kig (patch 0012): what a save state needs from ultramodern. The game thread that runs the idle loop
+// (pause_self) saves and loads at the top of that loop, when every other game thread is blocked in the
+// scheduler; the game provides the rest (RDRAM, each thread's registers and native call chain).
+#include <cstdint>
+#include <vector>
+
+#include "ultramodern/ultra64.h"
+
+struct UltraThreadContext;
+
+namespace ultramodern::savestate {
+    // Called by the idle thread at the top of its loop, with every other game thread blocked.
+    using idle_hook_t = void(uint8_t* rdram);
+    void set_idle_hook(idle_hook_t* hook);
+
+    // Runs a thread restored from a save state (UltraThreadContext::resume set), on that thread, in
+    // place of the thread's entrypoint.
+    using resume_thread_t = void(uint8_t* rdram, UltraThreadContext* context);
+    void set_resume_thread(resume_thread_t* func);
+
+    void run_idle_hook(uint8_t* rdram);  // (from pause_self)
+
+    UltraThreadContext* this_thread_context(uint8_t* rdram);
+    // Every live game thread's context (a copy of the list).
+    std::vector<UltraThreadContext*> live_threads();
+
+    // No RSP (graphics or audio) task in flight.
+    bool rsp_idle();
+    bool external_queue_empty();
+    void discard_external_messages();
+
+    PTR(OSThread) get_running_queue();
+    void set_running_queue(PTR(OSThread) head);
+
+    struct ViSave {
+        uint32_t mode;  // RDRAM address of the OSViMode, 0 for none, 1 for the pre-game dummy mode
+        PTR(void) framebuffer;
+        PTR(OSMesg) mq;
+        OSMesg msg;
+        uint32_t state;
+        uint32_t control;
+        int32_t retrace_count;
+    };
+    struct EventSave {
+        PTR(OSMesgQueue) sp_mq, dp_mq, ai_mq, si_mq;
+        OSMesg sp_msg, dp_msg, ai_msg, si_msg;
+        int32_t vi_cur_state;
+        int32_t vi_field;
+        ViSave vi[2];
+    };
+    EventSave get_events(uint8_t* rdram);
+    void set_events(uint8_t* rdram, const EventSave& save);
+
+    // Ends every game thread but the calling one (each must be blocked in the scheduler) and waits until
+    // they have exited. False if one didn't within a few seconds.
+    bool terminate_other_threads(uint8_t* rdram);
+    // Creates the host thread for the OSThread at t (whose RDRAM state is already in place). With
+    // resume, it runs the resume function; without, it waits to be started like a new thread.
+    UltraThreadContext* create_restored_thread(uint8_t* rdram, PTR(OSThread) t, PTR(void) entrypoint, PTR(void) arg, const void* resume);
+    // A restored thread that has rebuilt its call chain: blocks until the scheduler runs it.
+    void park_self(uint8_t* rdram);
+}
+
+#endif
