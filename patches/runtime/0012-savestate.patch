+
+bool ultramodern::savestate::terminate_other_threads(RDRAM_ARG1) {
+    UltraThreadContext* self = this_thread_context(PASS_RDRAM1);
+    std::vector<UltraThreadContext*> others;
+    for (UltraThreadContext* c : live_threads()) {
+        if (c != self) {
+            others.push_back(c);
+        }
+    }
+    // Each wakes in wait_for_resumed, sees its OSThread no longer points at it and terminates itself.
+    for (UltraThreadContext* c : others) {
+        OSThread* t = TO_PTR(OSThread, c->thread);
+        if (t->context == c) {
+            t->context = nullptr;
+        }
+        c->running.signal();
+    }
+    std::unique_lock lock{ live_mutex };
+    return live_cv.wait_for(lock, std::chrono::seconds(5), [&] {
+        for (UltraThreadContext* c : others) {
+            if (std::find(live_contexts.begin(), live_contexts.end(), c) != live_contexts.end()) {
+                return false;
+            }
+        }
+        return true;
+    });
+}
+
+UltraThreadContext* ultramodern::savestate::create_restored_thread(RDRAM_ARG PTR(OSThread) t_, PTR(void) entrypoint, PTR(void) arg, const void* resume) {
+    OSThread* t = TO_PTR(OSThread, t_);
+    UltraThreadContext* context = new UltraThreadContext{};
+    context->thread = t_;
+    context->entrypoint = entrypoint;
+    context->arg = arg;
+    context->resume = resume;
+    t->context = context;
+    add_live(context);
+    context->host_thread = std::thread{_thread_func, PASS_RDRAM t_, entrypoint, arg, context};
+    context->initialized.wait();
+    return context;
+}
+
+void ultramodern::savestate::park_self(RDRAM_ARG1) {
+    UltraThreadContext* context = this_thread_context(PASS_RDRAM1);
+    context->park = 1;
+    wait_for_resumed(PASS_RDRAM context);
+    context->park = 0;
+}
