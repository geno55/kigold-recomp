+
+bool ultramodern::savestate::rsp_idle() {
+    return gfx_tasks_pending.load() == 0 && sp_tasks_pending.load() == 0;
+}
+
+ultramodern::savestate::EventSave ultramodern::savestate::get_events(RDRAM_ARG1) {
+    std::lock_guard lock{ events_context.message_mutex };
+    EventSave save{};
+    save.sp_mq = events_context.sp.mq; save.sp_msg = events_context.sp.msg;
+    save.dp_mq = events_context.dp.mq; save.dp_msg = events_context.dp.msg;
+    save.ai_mq = events_context.ai.mq; save.ai_msg = events_context.ai.msg;
+    save.si_mq = events_context.si.mq; save.si_msg = events_context.si.msg;
+    save.vi_cur_state = events_context.vi.cur_state;
+    save.vi_field = events_context.vi.field;
+    for (int i = 0; i < 2; i++) {
+        const ViState& v = events_context.vi.states[i];
+        ViSave& o = save.vi[i];
+        if (v.mode == nullptr) {
+            o.mode = 0;
+        } else if (v.mode == &dummy_mode) {
+            o.mode = 1;
+        } else {
+            o.mode = (uint32_t)((const uint8_t*)v.mode - rdram) + 0x80000000u;
+        }
+        o.framebuffer = v.framebuffer;
+        o.mq = v.mq;
+        o.msg = v.msg;
+        o.state = v.state;
+        o.control = v.control;
+        o.retrace_count = v.retrace_count;
+    }
+    return save;
+}
+
+void ultramodern::savestate::set_events(RDRAM_ARG const EventSave& save) {
+    std::lock_guard lock{ events_context.message_mutex };
+    events_context.sp.mq = save.sp_mq; events_context.sp.msg = save.sp_msg;
+    events_context.dp.mq = save.dp_mq; events_context.dp.msg = save.dp_msg;
+    events_context.ai.mq = save.ai_mq; events_context.ai.msg = save.ai_msg;
+    events_context.si.mq = save.si_mq; events_context.si.msg = save.si_msg;
+    events_context.vi.cur_state = save.vi_cur_state & 1;
+    events_context.vi.field = save.vi_field;
+    for (int i = 0; i < 2; i++) {
+        const ViSave& o = save.vi[i];
+        ViState& v = events_context.vi.states[i];
+        v.mode = o.mode == 0 ? nullptr : o.mode == 1 ? &dummy_mode : TO_PTR(const OSViMode, (int32_t)o.mode);
+        v.framebuffer = o.framebuffer;
+        v.mq = o.mq;
+        v.msg = o.msg;
+        v.state = o.state;
+        v.control = o.control;
+        v.retrace_count = o.retrace_count;
+    }
+}
+
 ultramodern::renderer::ViRegs* ultramodern::renderer::get_vi_regs() {
     return &events_context.vi.update_screen_regs;
 }
