+// kig (patch 0006): run a raw RDP command list [start, end) (physical addresses) on the gfx thread, in
+// order with the gfx tasks, then raise the DP interrupt.
+void ultramodern::submit_rdp_list(uint32_t start, uint32_t end) {
+    gfx_tasks_pending++;
+    events_context.action_queue.enqueue(RdpListAction{ start, end });
+}
