 // kig (patch 0005): set_game_paused.
 static std::atomic<bool> game_paused{ false };
 
+// kig (patch 0010): synchronous gfx submission. The renderer reads textures and other display-list data
+// from RDRAM when it parses a gfx task or RDP list, on the gfx thread, some time after the game submitted
+// it. Games that keep updating that data on the CPU (KI Gold's title fire texture) would otherwise have
+// it read mid-update or a frame late. The submitting thread waits until its work has been parsed,
+// which is what the real RCP's immediate start amounts to. KIG_ASYNC_GFX=1 turns it off.
+static std::mutex gfx_sync_mutex;
+static std::condition_variable gfx_sync_cv;
+static uint64_t gfx_submitted_seq = 0;
+static uint64_t gfx_completed_seq = 0;
+static bool gfx_sync_enabled() {
+    static const bool enabled = std::getenv("KIG_ASYNC_GFX") == nullptr;
+    return enabled;
+}
+static uint64_t gfx_sync_begin() {
+    std::lock_guard lock{ gfx_sync_mutex };
+    return ++gfx_submitted_seq;
+}
+static void gfx_sync_wait(uint64_t seq) {
+    if (!gfx_sync_enabled()) {
+        return;
+    }
+    std::unique_lock lock{ gfx_sync_mutex };
+    gfx_sync_cv.wait_for(lock, std::chrono::milliseconds(500), [seq] { return gfx_completed_seq >= seq; });
+}
+static void gfx_sync_complete() {
+    {
+        std::lock_guard lock{ gfx_sync_mutex };
+        gfx_completed_seq++;
+    }
+    gfx_sync_cv.notify_all();
+}
+
 void ultramodern::set_game_paused(bool paused) {
     game_paused.store(paused);
 }
