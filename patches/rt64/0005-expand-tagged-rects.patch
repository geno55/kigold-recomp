+        // kig patch: KI Gold tags a rectangle in the reserved top bits of its second word (src/game/kig_hooks.cpp,
+        // the torch flames): bit 31 clips it to the whole wide screen, bit 30 draws it a screen width further left
+        // (it was moved right, since rectangle coordinates can't be negative). Only with the Expand aspect ratio.
+        const uint8_t rectTag = expandRectTag;
+        expandRectTag = 0;
+        if ((rectTag & 0x2) && !extended && (state->ext.userConfig->aspectRatio == UserConfiguration::AspectRatio::Expand) &&
+            (extAlignment.leftOrigin == G_EX_ORIGIN_NONE) && (extAlignment.rightOrigin == G_EX_ORIGIN_NONE))
+        {
+            if (rectTag & 0x1) {
+                const int32_t screenWidth = int32_t(colorImage.width) << 2;
+                ulx -= screenWidth;
+                lrx -= screenWidth;
+            }
+
+            extended = true;
+        }
+
         // kig patch: a rectangle tagged to repeat (KI Gold's raindrops, see GBI_F3D::runDl) is drawn again a screen
         // width to the left and to the right with the Expand aspect ratio. Each copy is clipped to its side strip,
         // so a drop that crosses an edge of the 4:3 area isn't doubled inside it.
