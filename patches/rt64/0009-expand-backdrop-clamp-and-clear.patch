@@ -1349,10 +1383,14 @@ namespace RT64 {
         const FixedRect &expandScissor = scissorRectStack[scissorStackSize - 1];
         const LoadTile &expandTile = tiles[tile];
         const bool expandRepeats = ((expandTile.cms & G_TX_CLAMP) == 0) && (expandTile.masks > 0);
+        // A clamped rectangle (KI Gold's fight backdrop seen through a stage's window, a pre-rendered picture wider
