         // that column is no longer at the edge, so it showed as a line.
@@ -1365,17 +1403,25 @@ namespace RT64 {
             const bool reachesLeft = (ulx <= expandScissor.ulx);
             const bool reachesRight = (lrx >= expandScissor.lrx - 4);
             const int32_t extension = expandScissor.lrx - expandScissor.ulx;
+            // How far a clamped rectangle can go (10.2 pixels) before s leaves the tile's texels: s is uls (10.5) plus
+            // dsdx (5.10) per pixel, and the tile spans uls..lrs (10.2) inclusive.
+            const int32_t texelsLeft = expandClamps ? ((int32_t(uls) - int32_t(expandTile.uls) * 8) * 128) / dsdx : extension;
+            const int32_t texelsRight = expandClamps ? ((int32_t(expandTile.lrs) * 8 + 32 - int32_t(uls)) * 128) / dsdx - (lrx - ulx) : extension;
             if (reachesLeft && !reachesRight) {
