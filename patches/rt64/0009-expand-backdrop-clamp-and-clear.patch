-                if (newUls >= INT16_MIN) {
-                    ulx -= extension;
+                const int32_t reach = std::min(extension, texelsLeft);
+                const int32_t newUls = uls - (int32_t(dsdx) * reach) / 128;
+                if ((reach > 0) && (newUls >= INT16_MIN)) {
+                    ulx -= reach;
                     uls = int16_t(newUls);
                     extended = true;
                 }
             }
             else if (reachesRight && !reachesLeft) {
-                lrx += extension;
-                extended = true;
+                const int32_t reach = std::min(extension, texelsRight);
+                if (reach > 0) {
+                    lrx += reach;
+                    extended = true;
+                }
             }
