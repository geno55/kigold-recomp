+    // kig patch: with the Expand aspect ratio, before the first draw of a raw RDP list for a fight frame, the side strips
+    // beside the 4:3 area are filled top to bottom with the fill colour (the list sets it, black, before drawing
+    // anything). A fight redraws its whole picture every frame but only clears what the 4:3 picture covers, so whatever
+    // it left undrawn at the sides showed earlier frames: pictures that lingered, smeared as the camera moved and jumped
+    // when something new was drawn there. Now it is black. KI Gold's fights draw into a 320-wide image; its menus
+    // (640 wide) redraw only parts of the picture each frame and keep the rest, sides included, so they are left alone.
+    void RDP::expandClearSides(const ExtendedAlignment &extAlignment) {
+        const FixedRect &expandScissor = scissorRectStack[scissorStackSize - 1];
+        constexpr uint32_t FightImageWidth = 320;
+        if (!inRawRdpList || expandSidesCleared || (state->ext.userConfig->aspectRatio != UserConfiguration::AspectRatio::Expand) ||
+            (colorImage.width != FightImageWidth) ||
+            expandScissor.isNull() || (expandScissor.ulx > 0) || (expandScissor.lrx < int32_t(colorImage.width << 2) - 4) ||
+            (extAlignment.leftOrigin != G_EX_ORIGIN_NONE) || (extAlignment.rightOrigin != G_EX_ORIGIN_NONE))
+        {
+            return;
+        }
+
+        expandSidesCleared = true;
+        const uint32_t savedH = otherMode.H;
+        const uint32_t savedL = otherMode.L;
+        setOtherMode((savedH & ~(3U << G_MDSFT_CYCLETYPE)) | G_CYC_FILL, savedL);
+        const int32_t screenWidth = int32_t(colorImage.width) << 2;
+        drawRect(expandScissor.ulx - screenWidth, expandScissor.uly, expandScissor.ulx | 3, expandScissor.lry | 3, 0, 0, 0, 0, false, extAlignment);
+        state->drawCall.expandSide = -1;
+        drawRect(expandScissor.lrx, expandScissor.uly, (expandScissor.lrx + screenWidth) | 3, expandScissor.lry | 3, 0, 0, 0, 0, false, extAlignment);
+        state->drawCall.expandSide = 1;
+        setOtherMode(savedH, savedL);
+    }
+
