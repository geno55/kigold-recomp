+                setMinSize(posWorkBuffer, vertCount);
+                setMinSize(colorWorkBuffer, vertCount);
+                setMinSize(texcoordWorkBuffer, vertCount);
+                // The largest |W| across the polygon bounds how far the clamp below may reach.
+                float maxW = 0.0f;
+                for (const ClipVertex &v : clippedTris) {
+                    maxW = std::max(maxW, std::fabs(v.w));
+                }
+                const float minW = std::max(maxW * 1e-4f, 1e-6f);
+                auto emit = [&](size_t index, const ClipVertex &v) {
+                    interop::float4 &p = posWorkBuffer[index];
+                    p.x = v.x; p.y = v.y; p.z = v.z;
+                    colorWorkBuffer[index] = interop::float4(v.r, v.g, v.b, v.a);
