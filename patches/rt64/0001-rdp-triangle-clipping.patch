+            // Build the triangle's polygon and clip it to the scissor before handing it to the GPU (kig patch).
+            // - The RDP fills between the major edge H and the minor edge M from YH to YM, then between H and
+            //   the minor edge L from YM to YL. RT64 assumed M and L meet at (XL, YM), as they do for an ordinary
+            //   triangle; KI Gold's CPU-built lists also send rectangles (H and M vertical, YM = YL), which that
+            //   turned into a zero-area triangle, so the area (the fight's sky) was never drawn. Each part is
+            //   built as its own trapezoid instead.
+            // - The corners of large triangles (KI Gold's CPU-built floors) lie far outside the drawn area;
+            //   extrapolated there, the perspective W can be zero or negative, and the GPU then clips or warps
+            //   the whole triangle (flickering/white floors). So the trapezoids are clipped to the scissor first.
+            // Colour, S, T, W and Z are linear in screen space, so they are evaluated exactly at every corner,
+            // where the real RDP evaluates them.
+            struct ClipVertex {
+                float x, y, z;
+                float r, g, b, a;
+                float s, t, w;
+            };
+            auto lerpVertex = [](const ClipVertex &p, const ClipVertex &q, float f) {
+                ClipVertex o;
+                o.x = p.x + (q.x - p.x) * f; o.y = p.y + (q.y - p.y) * f; o.z = p.z + (q.z - p.z) * f;
+                o.r = p.r + (q.r - p.r) * f; o.g = p.g + (q.g - p.g) * f; o.b = p.b + (q.b - p.b) * f; o.a = p.a + (q.a - p.a) * f;
+                o.s = p.s + (q.s - p.s) * f; o.t = p.t + (q.t - p.t) * f; o.w = p.w + (q.w - p.w) * f;
+                return o;
+            };
+            auto xOnH = [&](float y) { return edgeXh + edgeDxh * (y - edgeYFloor); };
+            auto xOnM = [&](float y) { return edgeXm + edgeDxm * (y - edgeYFloor); };
+            auto xOnL = [&](float y) { return edgeXl + edgeDxl * (y - edgeYm); };
+            auto corner = [&](float x, float y) {
+                float v[8];
+                for (int c = 0; c < 8; c++) {
+                    v[c] = planeBase[c] + planeDe[c] * (y - edgeYFloor) + planeDx[c] * (x - xOnH(y));
+                }
+                return ClipVertex{ x, y, v[7], v[0], v[1], v[2], v[3], v[4], v[5], v[6] };
+            };
+
+            const FixedRect &scissor = state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1];
+            const float clipBounds[4] = { scissor.ulx / 4.0f, scissor.uly / 4.0f, scissor.lrx / 4.0f, scissor.lry / 4.0f };
+            static thread_local std::vector<ClipVertex> clippedTris;
+            clippedTris.clear();
+            auto clipAndAdd = [&](ClipVertex *polyA, int polyCount) {
+                ClipVertex polyB[12];
+                ClipVertex *in = polyA, *out = polyB;
+                for (int plane = 0; (plane < 4) && (polyCount >= 3); plane++) {
+                    auto dist = [&](const ClipVertex &v) {
+                        switch (plane) {
+                        case 0: return v.x - clipBounds[0];
+                        case 1: return v.y - clipBounds[1];
+                        case 2: return clipBounds[2] - v.x;
+                        default: return clipBounds[3] - v.y;
+                        }
+                    };
+                    int outCount = 0;
+                    for (int v = 0; v < polyCount; v++) {
+                        const ClipVertex &cur = in[v];
+                        const ClipVertex &nxt = in[(v + 1) % polyCount];
+                        float dc = dist(cur), dn = dist(nxt);
+                        if (dc >= 0.0f) {
+                            out[outCount++] = cur;
+                        }
+                        if ((dc >= 0.0f) != (dn >= 0.0f)) {
+                            out[outCount++] = lerpVertex(cur, nxt, dc / (dc - dn));
+                        }
+                    }
+                    polyCount = outCount;
+                    std::swap(in, out);
+                }
+                for (int t = 1; t + 1 < polyCount; t++) {
+                    clippedTris.push_back(in[0]);
+                    clippedTris.push_back(in[t]);
+                    clippedTris.push_back(in[t + 1]);
+                }
+            };
