+                ClipVertex upper[12] = { corner(xOnH(edgeYh), edgeYh), corner(xOnM(edgeYh), edgeYh),
+                                         corner(xOnM(edgeYm), edgeYm), corner(xOnH(edgeYm), edgeYm) };
+                clipAndAdd(upper, 4);
+            }
+            if (edgeYl > edgeYm) {
