+                        p.w = 65536000.0f / w;
+                        texcoordWorkBuffer[index] = interop::float2((v.s / w) * 1024.0f, (v.t / w) * 1024.0f);
+                    }
+                    else if (anyTextured) {
+                        p.w = 1.0f;
+                        texcoordWorkBuffer[index] = interop::float2((v.s * 1024.0f) / 16384.0f, (v.t * 1024.0f) / 16384.0f);
+                    }
+                    else {
+                        p.w = 1.0f;
+                        texcoordWorkBuffer[index] = interop::float2(0.0f, 0.0f);
+                    }
+                };
+                for (size_t v = 0; v < vertCount; v++) {
+                    emit(v, clippedTris[v]);
+                }
+                state->rdp->drawTris((uint32_t)(vertCount / 3),&posWorkBuffer.data()[0][0], &texcoordWorkBuffer.data()[0][0], &colorWorkBuffer[0][0], tile, level);
+            }
 
             return trianglesEnd;
         }
