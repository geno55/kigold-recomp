+                ClipVertex lower[12] = { corner(xOnH(yTop), yTop), corner(xOnL(yTop), yTop),
+                                         corner(xOnL(edgeYl), edgeYl), corner(xOnH(edgeYl), edgeYl) };
+                clipAndAdd(lower, 4);
+            }
+
+            if (!clippedTris.empty()) {
