+// kig patch: the RDP texture filter's YUV-to-RGB conversion of one texel, as angrylion's texture_pipeline_cycle
+// does it: Y is the texel's blue, U its red and V its green; K0-K3 are SETCONVERT's 9-bit signed constants,
+// used as 2K+1. The results are 9 bits, read by the combiner as -128..383 (the RDP's 9-bit extension).
+int convertExtend9(int v) {
+    v &= 0x1FF;
+    return ((v & 0x180) == 0x180) ? (v - 0x200) : v;
+}
+
+float4 convertTexel(float4 texel, int convertK[4]) {
+    const int y = int(round(texel.b * 255.0f));
+    const int u = int(round(texel.r * 255.0f));
+    const int v = int(round(texel.g * 255.0f));
+    int k[4];
+    for (int i = 0; i < 4; i++) {
+        const int k9 = convertK[i] & 0x1FF;
+        k[i] = (((k9 & 0x100) != 0) ? (k9 - 0x200) : k9) * 2 + 1;
+    }
+
+    const int r = y + ((k[0] * v + 0x80) >> 8);
+    const int g = y + ((k[1] * u + k[2] * v + 0x80) >> 8);
+    const int b = y + ((k[3] * u + 0x80) >> 8);
+    return float4(convertExtend9(r), convertExtend9(g), convertExtend9(b), convertExtend9(y)) / 255.0f;
+}
