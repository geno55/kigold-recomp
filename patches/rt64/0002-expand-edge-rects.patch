+        // kig patch: with the Expand aspect ratio, a repeating texture rectangle from a raw RDP list that reaches
+        // one side of a full-width scissor (a background band drawn in several strips, like KI Gold's character
+        // select fire) is extended past that side by a screen width, its texture continuing, so it fills the
+        // wider screen. Only the strips at the edges reach a side; a rectangle that covers the whole width is
+        // already stretched when drawn. Gfx task rectangles (sprites that happen to touch an edge) are left alone.
+        const FixedRect &expandScissor = scissorRectStack[scissorStackSize - 1];
+        const LoadTile &expandTile = tiles[tile];
+        const bool expandCandidate = inRawRdpList && (state->ext.userConfig->aspectRatio == UserConfiguration::AspectRatio::Expand) && !flip &&
+            !expandScissor.isNull() && (expandScissor.ulx <= 0) && (expandScissor.lrx >= int32_t(colorImage.width << 2) - 4) &&
+            (extAlignment.leftOrigin == G_EX_ORIGIN_NONE) && (extAlignment.rightOrigin == G_EX_ORIGIN_NONE) &&
+            ((expandTile.cms & G_TX_CLAMP) == 0) && (expandTile.masks > 0);
+        // A sliver at the edge (KI Gold's fire also redraws a 1-pixel column at the right) is skipped: its
+        // texture doesn't line up with the strip next to it, which is extended over it, and on a wider screen
+        // that column is no longer at the edge, so it showed as a line.
+        constexpr int32_t MinExpandWidth = 8 << 2;
+        if (expandCandidate && ((lrx - ulx) < MinExpandWidth) && ((ulx <= expandScissor.ulx) || (lrx >= expandScissor.lrx - 4))) {
+            return;
+        }
+        bool extended = false;
+        if (expandCandidate) {
+            const bool reachesLeft = (ulx <= expandScissor.ulx);
+            const bool reachesRight = (lrx >= expandScissor.lrx - 4);
+            const int32_t extension = expandScissor.lrx - expandScissor.ulx;
+            if (reachesLeft && !reachesRight) {
+                const int32_t newUls = uls - (int32_t(dsdx) * extension) / 128;
+                if (newUls >= INT16_MIN) {
+                    ulx -= extension;
+                    uls = int16_t(newUls);
+                    extended = true;
+                }
+            }
+            else if (reachesRight && !reachesLeft) {
+                lrx += extension;
+                extended = true;
+            }
+        }
+
         drawRect(ulx, uly, lrx, lry, uls, ult, dsdx, dtdy, flip, extAlignment);
+        if (extended) {
+            state->drawCall.expandExtended = true;  // the renderer clips it to the wide screen
+        }
     }
 
