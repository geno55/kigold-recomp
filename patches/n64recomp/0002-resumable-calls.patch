+// Resumable calls (save states). Every call site is emitted as
+//     resume_<site>: RECOMP_SS_PUSH(<site>, <target>); <call>; RECOMP_SS_POP();
+// so the runtime keeps a shadow stack of the call sites each thread is in, and each function ends with a
+// dispatch (reached from its start while RECOMP_RESUMING()) that jumps back into the call it was in. The
+// runtime defines the macros and recomp_resume_enter(), which returns the site to re-enter, or the site
+// | 1 to return from that call instead (to its after_ label, or out of the function for a tail call).
+// <site> is the vram of the call instruction, unique within the function.
+namespace {
+    struct ResumeSite {
+        uint32_t site;
+        int after_index;  // after_<n> label, or -1 for a tail call
+    };
+    thread_local std::vector<ResumeSite> resume_sites;
+    thread_local std::set<uint32_t> resume_site_set;
+
+    // The resume label for a call site (none if the site already has one: then it can't be resumed).
+    void emit_resume_label(std::ostream& output_file, uint32_t site, int after_index) {
+        if (resume_site_set.insert(site).second) {
+            resume_sites.push_back({ site, after_index });
+            fmt::print(output_file, "resume_{:08X}: ", site);
+        }
+    }
+
+    // Label and push before a direct call.
+    void emit_resume_begin(std::ostream& output_file, uint32_t site, int after_index) {
+        emit_resume_label(output_file, site, after_index);
+        fmt::print(output_file, "RECOMP_SS_PUSH(0x{:08X}u, 0);\n    ", site);
+    }
+
+    void emit_resume_end(std::ostream& output_file) {
+        fmt::print(output_file, "    RECOMP_SS_POP();\n");
+    }
+
+    // An indirect call through `expr` (a gpr expression). The target is recorded on the shadow stack and
+    // taken from there when the call is being resumed (the register may no longer hold it).
+    void emit_resumable_indirect_call(std::ostream& output_file, uint32_t site, int after_index, const std::string& expr) {
+        emit_resume_label(output_file, site, after_index);
+        fmt::print(output_file, "{{ gpr rt_ = RECOMP_RESUME_TARGET({}); RECOMP_SS_PUSH(0x{:08X}u, rt_);\n", expr, site);
+        fmt::print(output_file, "    LOOKUP_FUNC(rt_)(rdram, ctx);\n");
+        emit_resume_end(output_file);
+        fmt::print(output_file, "    }}\n");
+    }
+}
